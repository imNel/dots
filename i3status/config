# i3status configuration file.
# see "man i3status" for documentation.

general {
        colors = false
        interval = 5
}

order += "wireless _first_"
order += "battery 0"
order += "tztime local"

wireless _first_ {
        format_up = "%essid%quality"
        format_down = "No WiFi"
}

battery 0 {
        format = "%status %percentage"
	path = "/sys/class/power_supply/macsmc-battery/uevent"
}

tztime local {
        format = "%b %d - %I:%M %p"
}
